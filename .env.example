PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Required in production: a random string of at least 32 characters
JWT_SECRET=
# Local durable database; back this file up. Run one server instance.
DATA_FILE=./data/database.json
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NotesNexa <noreply@example.com>
# Only for local testing: prints signup codes to the server terminal.
DEV_OTP_LOG=true

# Optional direct workspace account. Password must be 12+ characters.
SUPER_EMAIL=
SUPER_PASSWORD=
SUPER_NAME=Workspace Owner

# Vercel / MongoDB / Cloudinary / scheduled email reminders
MONGODB_URI=
MONGODB_DB=notesnexa
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
APP_URL=http://127.0.0.1:3000
CRON_SECRET=
